{
  "name": "methane-response",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && bun run dev",
    "dev:api": "cd apps/api && bun run dev",
    "build:web": "cd apps/web && bun run build",
    "check": "cd apps/api && bun run typecheck && cd ../web && bun run typecheck && cd ../.. && bun run check:e2e && bun run check:evaluation && bun run check:agent-lab",
    "check:e2e": "tsc --project tsconfig.e2e.json",
    "check:evaluation": "tsc --project scripts/tsconfig.evaluation.json",
    "check:agent-lab": "tsc --project tsconfig.agent-lab.json",
    "test:api": "cd apps/api && bun test",
    "test:web": "cd apps/web && bun test",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:map-performance": "bun test scripts/map-performance-utils.test.ts",
    "measure:map-performance": "bun scripts/measure-map-performance.ts",
    "check:web-bundle": "bun scripts/check-web-bundle.ts",
    "freeze:ai-inputs": "bun scripts/freeze-ai-assessment-inputs.ts",
    "test:verifier": "bun test scripts/verify-audit.test.ts scripts/run-ai-benchmark.test.ts scripts/freeze-ai-assessment-inputs.test.ts scripts/verify-agent-diagnostic.test.ts scripts/deployment-config.test.ts scripts/map-performance-utils.test.ts scripts/check-local.test.ts scripts/product-value-evaluation.test.ts scripts/verify-plan.test.ts scripts/verify-snapshot-transition.test.ts scripts/verify-investigation.test.ts scripts/verify-investigation-decision.test.ts scripts/stage-snapshot-update.test.ts scripts/verify-evidence-overlap.test.ts scripts/probe-document-ai.test.ts scripts/export-investigation-brief.test.ts",
    "test:local-gates": "bun test scripts/check-local.test.ts",
    "test:case-work-operations": "bun --no-env-file scripts/run-case-work-operations.ts",
    "test:publication-operations": "bun --no-env-file scripts/run-publication-operations.ts",
    "test:integration-roles": "bun --no-env-file scripts/run-integration-roles.ts",
    "test:data": "cd services/data-pipeline && uv run --locked --extra research pytest",
    "evaluate:baseline": "cd services/data-pipeline && uv run python evaluate_baseline.py --output reports/baseline-evaluation.json",
    "test:contracts": "cd contracts && forge test",
    "check:all": "bash scripts/check-local.sh",
    "verify:audit": "bun scripts/verify-audit.ts",
    "test:chain-integration": "bun --no-env-file scripts/run-chain-integration.ts",
    "prove:decision": "bun --no-env-file scripts/decision-lab-proof.ts",
    "prove:observations": "bun --no-env-file scripts/observation-claim-proof.ts",
    "prove:planner": "bun --no-env-file scripts/investigation-planner-proof.ts",
    "verify:plan": "bun --no-env-file scripts/verify-plan.ts",
    "verify:investigation-decision": "bun --no-env-file scripts/verify-investigation-decision.ts",
    "verify:investigation": "bun --no-env-file scripts/verify-investigation.ts",
    "prove:operations": "bun --no-env-file scripts/investigation-operations-proof.ts",
    "build:snapshot-transition": "bun --no-env-file scripts/build-snapshot-transition.ts",
    "stage:snapshot": "bun --no-env-file scripts/stage-snapshot-update.ts",
    "verify:evidence-overlap": "bun --no-env-file scripts/verify-evidence-overlap.ts",
    "verify:snapshot-transition": "bun --no-env-file scripts/verify-snapshot-transition.ts",
    "prove:snapshot-transition": "bun --no-env-file scripts/snapshot-transition-proof.ts",
    "evaluate:product-value": "bun --no-env-file scripts/product-value-evaluation.ts",
    "agent-lab:prepare": "bun --no-env-file scripts/agent-usefulness/prepare.ts",
    "agent-lab:gates": "bun --no-env-file scripts/agent-usefulness/gates.ts",
    "agent-lab:dry-run": "bun --no-env-file run playwright test --config playwright.agent-lab.config.ts",
    "agent-lab:sealed": "bun --no-env-file run playwright test --config playwright.agent-lab-run.config.ts",
    "agent-lab:all": "bun --no-env-file scripts/agent-usefulness/run-all.ts",
    "agent-lab:run-luna": "bash scripts/agent-usefulness/run-openai-luna.sh",
    "agent-lab:run-luna-max": "bash scripts/agent-usefulness/run-codex-luna-max.sh",
    "agent-lab:finalize": "bun --no-env-file scripts/agent-usefulness/finalize.ts",
    "agent-lab:test": "bun test scripts/agent-usefulness",
    "export:investigation-brief": "bun --no-env-file scripts/export-investigation-brief.ts",
    "demo:workflow": "bun --no-env-file scripts/run-e2e-ai.ts e2e/ai-review-workflow.spec.ts --grep \"connected investigation preserves\""
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0"
  }
}
