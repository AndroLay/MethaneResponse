# Local dev: keep empty; Vite proxies /api to METHANE_API_PROXY_TARGET (default localhost:3001)
# Cloudflare Pages: set to the Render API origin
VITE_API_BASE_URL=
# Optional Vite-only development proxy target. Set this if the API is not on localhost:3001.
METHANE_API_PROXY_TARGET=http://localhost:3001
