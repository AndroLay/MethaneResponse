# API (copy to apps/api/.env; never commit the real file)
PORT=3001
# Optional bind address. Use 127.0.0.1 for local-only access; hosted services need 0.0.0.0 (the default).
# HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
AUDIT_STORE_PATH=../../data/state/audits.json
MARS_CASEBOOK_PATH=../../data/real/mars_casebook_2026-10-15.json
# Optional: all AI/provider secrets remain on the API server.
# AI_BASE_URL=https://trusted-provider.example/v1
# AI_MODEL=provider-model-name
# AI_API_KEY=generate-a-provider-key
# AI_REVIEW_TOKEN=generate-a-different-random-secret-of-32-plus-characters
# Preferred production human-review authentication: issue short-lived scoped tokens locally.
# REVIEWER_AUTH_SECRET=generate-a-separate-random-secret-of-32-plus-characters
# Legacy shared reviewer tokens are local-development compatibility only; a production opt-in permits private_read/review but never anchor/reconcile.
# HUMAN_REVIEW_TOKEN=generate-a-separate-random-secret-of-32-plus-characters
# HUMAN_REVIEWER_ID=authorized-reviewer-01
# INTELLIGENCE_SNAPSHOT_PATH=../../data/processed/intelligence-snapshot.json
# INTELLIGENCE_INPUT_PATH=../../apps/web/public/data/mars-snapshot.json.gz
# Audits use the local atomic JSON file store. The default path is data/state/audits.json.
# Hosted preview filesystems may be ephemeral; do not treat them as durable backups.
# Optional administrator authorization for baseline audit writes in production mode.
# ADMIN_API_TOKEN=generate-a-long-random-secret
# Optional, only for checking an existing Sepolia receipt; local API anchoring is disabled.
# SEPOLIA_RPC_URL=https://...
# AUDIT_REGISTRY_ADDRESS=0x...
# Never expose signer keys or API tokens in VITE_* variables.
# Never commit real tokens, provider credentials, RPC credentials, or signer keys.
