{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "typeRoots": ["./node_modules/@types", "./apps/api/node_modules/@types"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@methane/shared": ["./packages/shared/src/index.ts"],
      "@methane/shared/*": ["./packages/shared/src/*.ts"]
    }
  },
  "include": [
    "playwright.agent-lab.config.ts",
    "playwright.agent-lab-run.config.ts",
    "playwright.agent-lab-smoke.config.ts",
    "e2e/agent-lab/**/*.ts",
    "scripts/agent-usefulness/**/*.ts"
  ]
}
